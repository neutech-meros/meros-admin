# Base URL of the Meros API that the admin proxies call.
# Required in production; defaults to http://localhost:3005 in development and test.
MEROS_API_URL=http://localhost:3005

# Admin API key sent as a Bearer token to the Meros API admin endpoints. Server-only, never expose to the browser.
# Required in production; defaults to a dev-only key in development and test.
MEROS_ADMIN_API_KEY=dev-admin-key

# Identifies this tool (not a person) as the actor on admin write actions. Server-only.
# Required in production; defaults to "meros-admin" in development and test.
MEROS_ADMIN_ACTOR=meros-admin

# Stop-gap kill switch for the unauthenticated /api/admin/moderation/* proxy. Server-only.
# Defaults to enabled in development and test, and OFF in production until the real
# admin-auth guard lands. Uncomment only to override that default.
#ADMIN_MODERATION_PROXY_ENABLED=true

# Same kill switch for the /api/admin/business-accounts/* proxy.
#ADMIN_BUSINESS_ACCOUNTS_PROXY_ENABLED=true
